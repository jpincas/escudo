# Escudo bot — committed, non-secret defaults.
# This file doubles as the canonical list of every env var the bot reads.
#
# Precedence (first wins):  real shell env  >  .env.local  >  this file.
# Loaded by the `dev` and `start` deno tasks via --env-file.
#
# ⚠ Deno Deploy does NOT read these files. In production set vars with
#   `deno deploy env add <KEY> <VALUE> --org=<org> --app=<app>`.

# Path to the village config file, relative to this directory.
ESCUDO_CONFIG=config.yaml

# Port for the webhook server (main.ts). Deploy sets this for you.
ESCUDO_PORT=8000

# ── Per-deployment wiring → set these in .env.local (gitignored), never here ──
# ESCUDO_BOT_TOKEN=       # from @BotFather. Required. The one real secret.
# ESCUDO_GROUP_CHAT_ID=   # the village group alerts post to. Required. /chatid in the group.
# ESCUDO_ADMIN_CHAT_ID=   # optional private chat for maintenance alerts.
# ESCUDO_WEBHOOK_SECRET=  # secret URL path for the webhook; defaults to the bot token
# ESCUDO_KV_PATH=         # empty = Deno's default KV. Set e.g. ./data/escudo.db to self-host.
# ESCUDO_PUBLIC_URL=      # e.g. https://escudo-bot.<org>.deno.net. Set = Telegram webhooks and
#                         # panel links; unset = polling and no links.
# ESCUDO_TELEGRAM=        # "off" for dev: no bot, no group, alerts print to the terminal.

# ── The call bridge ──
# ESCUDO_ZADARMA_API_SECRET=   # Zadarma account secret (Settings → API). Unset = /bridge/voice
#                              # is not mounted at all and a call raises nothing.
# ESCUDO_ZADARMA_IVR_PLAY_ID=  # id of an uploaded recording, a hex string like a6842305f1996e34.
#                              # Unset = the bridge says nothing and the PBX's own greeting runs.
# ESCUDO_TWILIO_AUTH_TOKEN=    # only for somewhere that sells a number doing calls AND SMS,
#                              # which Spain does not. Zadarma wins if both are set.
# ESCUDO_BRIDGE_CHECK_SOURCE_IP=  # true/false, default false. Refuse anything not from Zadarma's
#                              # 185.45.152.40/30. Off because it refused every real call on Deno
#                              # Deploy — see DEPLOY.md. Only turn it on behind a proxy whose
#                              # x-forwarded-for you have verified with an actual call.
