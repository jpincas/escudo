{
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run --unstable-kv --allow-net --allow-read --allow-write --allow-env --env-file=.env.local --env-file=.env dev.ts",
    "start": "deno run --unstable-kv --unstable-cron --allow-net --allow-read --allow-write --allow-env --env-file=.env.local --env-file=.env main.ts",
    "set-webhook": "deno run --allow-net --allow-read --allow-env --env-file=.env.local --env-file=.env scripts/set-webhook.ts",
    "test": "deno test --unstable-kv --allow-read --allow-write --allow-env tests/",
    "iterate": "deno check main.ts dev.ts",
    "check": "deno fmt --check && deno lint && deno check main.ts dev.ts && deno task test",
    "panel:install": "cd panel && deno install",
    "panel:dev": "cd panel && deno run -A npm:vite",
    "build": "deno task panel:install && cd panel && deno run -A npm:vite build"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "grammy": "npm:grammy@^1.45.1",
    "hono": "jsr:@hono/hono@^4",
    "hono/deno": "jsr:@hono/hono@^4/deno",
    "@grammyjs/auto-retry": "npm:@grammyjs/auto-retry@^2",
    "zod": "npm:zod@^4.0.0"
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"],
    "strict": true
  },
  "lint": {
    // panel/ is browser code with its own toolchain: `window` is correct there,
    // and Deno's rules are the wrong ones to judge it by.
    "exclude": ["panel/"],
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "fmt": {
    "exclude": ["panel/"],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2
  },
  "deploy": {
    "org": "jpincas",
    "app": "escudo-bot"
  }
}

